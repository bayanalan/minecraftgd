# Godot's import cache (regenerated by the editor on every machine)
.godot/
/android/

# Build output (regenerated by the export presets / tools/build_native.ps1; kept out of git: pushes took too long)
/builds/
/native/obj/

# Temporary files: Godot's shadow copies of locked GDExtension DLLs, interrupted saves
native/bin/~*
*.TMP
*.tmp
